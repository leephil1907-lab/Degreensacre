# ============================================
# DE-GREENACRES PROPERTIES - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# ============================================

# --- Supabase Configuration ---
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# NOTE: SUPABASE_SERVICE_ROLE_KEY is NOT required — app uses anon key + RLS only
# If you have an older deployment that still references it, you can safely remove it.

# --- Site Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend Email Configuration ---
# Create account at https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=De-Greenacres <noreply@degreenacresproperties.com>
EMAIL_REPLY_TO=info@degreenacresproperties.com

# --- WhatsApp Configuration ---
NEXT_PUBLIC_WHATSAPP_NUMBER=2348065019971
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello, I'm interested in your properties on De-Greenacres.

# --- Contact Details ---
NEXT_PUBLIC_COMPANY_NAME=De-Greenacres Properties Limited
NEXT_PUBLIC_RC_NUMBER=1856064
NEXT_PUBLIC_PHONE=+2348065019971
NEXT_PUBLIC_EMAIL=info@degreenacresproperties.com
NEXT_PUBLIC_ALT_EMAIL=de_greenacrespropertiesltd@yahoo.com

# --- Optional: Analytics ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Google AdSense (Earnings) ---
# Create account at https://adsense.google.com → Sites → Add site (degreenacres.com) → Get publisher ID (ca-pub-...)
# Add this to Vercel → Settings → Environment Variables (Production/Preview/Development) then redeploy.
# Leave as placeholder until approved — placeholders show where ads will appear, but no real ads.
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
# Optional: specific ad slot IDs after you create ad units in AdSense → Ads → By ad unit → Get slot ID
# NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=1234567891
# NEXT_PUBLIC_ADSENSE_SLOT_INFEED=1234567892

# --- Optional: Map Configuration ---
# NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
