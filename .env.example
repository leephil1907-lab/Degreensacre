# ============================================
# DE-GREENACRES PROPERTIES - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# ============================================

# --- Supabase Configuration ---
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# NOTE: SUPABASE_SERVICE_ROLE_KEY is NOT required — app uses anon key + RLS only
# If you have an older deployment that still references it, you can safely remove it.

# --- Site Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example: https://degreensacre.onrender.com or your custom domain.
# RENDER_EXTERNAL_URL is supplied automatically by Render; do not set it manually.

# --- Optional: Cross-origin API access ---
# Defaults to * (public, non-credentialed CORS). Set a single trusted origin
# to allow credentialed cross-origin requests, e.g. https://degreenacres.org
# CORS_ALLOWED_ORIGIN=https://degreenacres.org

# --- Resend Email Configuration ---
# Create account at https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=De-Greenacres <noreply@degreenacresproperties.com>
EMAIL_REPLY_TO=info@degreenacresproperties.com

# --- WhatsApp Configuration ---
NEXT_PUBLIC_WHATSAPP_NUMBER=2348065019971
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello, I'm interested in your properties on De-Greenacres.

# --- Contact Details ---
NEXT_PUBLIC_COMPANY_NAME=De-Greenacres Properties Limited
NEXT_PUBLIC_RC_NUMBER=1856064
NEXT_PUBLIC_PHONE=+2348065019971
NEXT_PUBLIC_EMAIL=info@degreenacresproperties.com
NEXT_PUBLIC_ALT_EMAIL=de_greenacrespropertiesltd@yahoo.com

# --- Optional: Analytics ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Google AdSense (Earnings) ---
# Create account at https://adsense.google.com → Sites → Add site (degreenacres.com) → Get publisher ID (ca-pub-...)
# Add this to Render → Environment, then redeploy.
# Leave unconfigured until approved — no ad script, setup message or empty ad placeholder is rendered.
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
# Optional: specific ad slot IDs after you create ad units in AdSense → Ads → By ad unit → Get slot ID
# NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=1234567891
# NEXT_PUBLIC_ADSENSE_SLOT_INFEED=1234567892

# --- Map Configuration ---
# OpenStreetMap tiles and Nominatim address search are used by the core maps.
# Set a deployment-specific Nominatim User-Agent with a real contact URL/email.
# GEOCODING_USER_AGENT=De-Greenacres/1.0 (https://your-domain.com; admin@your-domain.com)
# NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
