{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "De-Greenacres • Featured",
          "weight": "Bolder",
          "size": "Small",
          "color": "Light",
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${title}",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true,
      "maxLines": 2
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "${image}",
              "size": "Medium",
              "style": "Person"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${area}, ${state}", "isSubtle": true, "size": "Small", "wrap": true },
            { "type": "TextBlock", "text": "${price}", "weight": "Bolder", "color": "Good", "size": "Medium" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${description}",
      "isSubtle": true,
      "size": "Small",
      "wrap": true,
      "maxLines": 2
    }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "View", "url": "${url}", "style": "positive" },
    { "type": "Action.OpenUrl", "title": "Browse all", "url": "/properties?source=widget", "style": "default" }
  ]
}
