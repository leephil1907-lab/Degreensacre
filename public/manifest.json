{
  "id": "/",
  "name": "De-Greenacres Properties",
  "short_name": "Degreensacre",
  "description": "Nigeria's Premium Property Intelligence Platform - Discover, Invest, and Manage Properties with Confidence. RC: 1856064",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed"],
  "orientation": "any",
  "background_color": "#f8f8e8",
  "theme_color": "#283818",
  "lang": "en",
  "dir": "ltr",
