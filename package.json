{
  "name": "de-greenacres",
  "version": "1.0.0",
  "description": "Production-grade Nigerian real estate marketplace",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run build",
    "pwa:package:test": "./scripts/generate-test-package.sh",
    "pwa:validate": "node -e \"const j=require('./public/manifest.json'); console.log('manifest', Object.keys(j).length, 'keys'); console.log('screenshots', j.screenshots.map(s=>s.sizes)); console.log('display_override', j.display_override); console.log('scope_extensions', !!j.scope_extensions); console.log('file_handlers', !!j.file_handlers); console.log('widgets', j.widgets?.length); console.log('note_taking', !!j.note_taking); console.log('iarc', j.iarc_rating_id);\""
  },
  "keywords": [
    "real-estate",
    "nigeria",
    "property",
    "marketplace",
    "nextjs",
    "supabase"
  ],
  "author": "De-Greenacres Properties Limited",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "framer-motion": "^13.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "next": "16.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "resend": "^6.28.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
